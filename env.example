# Surf API Key — get yours at https://agents.asksurf.ai
# Free tier: 30 credits/day (no key needed)
# Paid tier: unlimited — add your key here
NEXT_PUBLIC_SURF_API_KEY=your_surf_api_key_here

# Base RPC URL (public endpoint or Alchemy/QuickNode)
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id_here
